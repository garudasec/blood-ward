# Application
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bloodward?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# URLs
CLIENT_URL=http://localhost:5173

# Admin Credentials Placeholder
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production

# Set ADMIN_BOOTSTRAP_RESET=true to reset admin password to ADMIN_PASSWORD on startup
ADMIN_BOOTSTRAP_RESET=false
