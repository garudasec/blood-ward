# Application
NODE_ENV=development
PORT=5000

# Reverse Proxy Configuration (Render uses 1 hop; set to 1 in production or when behind reverse proxy)
TRUST_PROXY=1

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bloodward?retryWrites=true&w=majority
# Dedicated Test Database (Required for running automated tests; must NOT target production 'bloodward')
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bloodward_test?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# URLs
CLIENT_URL=http://localhost:5173

# Admin Credentials Placeholder
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production

# Set ADMIN_BOOTSTRAP_RESET=true to reset admin password to ADMIN_PASSWORD on startup
ADMIN_BOOTSTRAP_RESET=false

# Encryption (AES-256-GCM - required minimum 32 characters)
ENCRYPTION_SECRET=your_32_byte_or_64_hex_encryption_secret_here

# OTP HMAC Key (HMAC-SHA256 - required minimum 32 characters, kept separate from ENCRYPTION_SECRET)
OTP_HMAC_SECRET=your_32_byte_or_64_hex_otp_hmac_secret_here

# Optional: Max OTP requests per target per rolling hour (default: 5)
OTP_MAX_PER_TARGET_PER_HOUR=5
